 @article{Robinson_Chen_2003,
  title        = {Scheduling doctors’ appointments: Optimal and empirically-based heuristic policies},
  volume       = {35},
  doi          = {10.1080/07408170304367},
  abstractnote = {Consider the problem facing a doctor (or other service provider) who is setting patient appointment times in the presence of random service times. He or she must balance the patients’ waiting times (if the appointments are scheduled too closely together) against the doctor’s idle time (if the appointments are spaced too far apart). Although this problem is fairly intractable, this paper uses the structure of the optimal solution as the basis for a simple closed-form heuristic for setting appointment times. Over a wide test bed of problems, this heuristic is shown to perform on average within 2% (and generally within 0.5%) of the optimal policy.},
  number       = {3},
  journal      = {IIE Transactions (Institute of Industrial Engineers)},
  author       = {Robinson, L.W. and Chen, R.R.},
  year         = {2003},
  pages        = {295–307}
}

